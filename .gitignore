# ------------------------------------------------------------- environment files
# `.env` is deliberately *not* committed: GitHub push protection rejects any file
# holding `NEXT_PUBLIC_MAPBOX_TOKEN` (`GH013: Push cannot contain secrets`), even
# though the value is a public (`pk.*`) token. Locally `.env` still works; on CI
# the value comes from an Actions variable/secret (see .github/workflows/deploy.yml).
.env
.env.local
.env*.local
.env.development
.env.production

# --------------------------------------------------------------------- hosting
.vercel

# ------------------------------------------------------------------------- ide
.idea/
*.swp

# ------------------------------------------------------------- environment files
# `.env` is deliberately *not* committed: GitHub push protection rejects the
# Mapbox token it holds (`GH013: Push cannot contain secrets`). Locally it still
# works fine; on CI the token is injected from the `NEXT_PUBLIC_MAPBOX_TOKEN`
# Actions secret (see .github/workflows/deploy.yml).
.env
.env.local
.env*.local
.env.development
.env.production

